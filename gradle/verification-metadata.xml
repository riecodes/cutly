<?xml version="1.0" encoding="UTF-8"?>
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <!-- Everything except sherpa-onnx comes from Google Maven, Maven Central or the Gradle
              plugin portal, where a published version cannot be replaced. -->
         <trust group="^(?!com[.]k2fsa[.]).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <!-- A GitHub release asset can be replaced after publishing, so this one is pinned.
           A version bump fails the build until the new hash is added here. -->
      <component group="com.k2fsa.sherpa.onnx" name="sherpa-onnx" version="1.13.7">
         <artifact name="sherpa-onnx-1.13.7.aar">
            <sha256 value="c4ef49e309f24fcee5c106b8a279481aaecaabb078cd37b2cd6e9a62cc8a73c8" origin="Downloaded from the v1.13.7 GitHub release on 2026-10-03"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
